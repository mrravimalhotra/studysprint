# Supabase (Auth + Postgres/pgvector + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime LLM providers — only GOOGLE_API_KEY is required by default.
# Anthropic/OpenAI are optional fallbacks selectable per task type from the admin panel.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage bucket used for uploaded source pages and generated PDFs.
SUPABASE_STORAGE_BUCKET=studysprint
